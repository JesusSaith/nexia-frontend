{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx ng build",
  "outputDirectory": "dist/nexia-frontend/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://CAMBIA-POR-TU-BACKEND/api/:path*" },
    { "source": "/s/:slug", "destination": "https://CAMBIA-POR-TU-BACKEND/s/:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
